@model CategoryManagementViewModel
@{ ViewData["Title"] = "Categories - " + Model.Event.EventName; }

<div class="page-head">
    <div>
        <h1>Categories</h1>
        <p><strong>@Model.Event.EventName</strong> &middot; @Model.Event.EventDate.ToString("d MMM yyyy")</p>
    </div>
    <a class="btn btn-rd-outline" asp-action="Events">Back to my events</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <h2>Offered at this event</h2>
        @if (Model.EventCategories.Count == 0)
        {
            <div class="rd-panel text-muted">No categories yet. Add one using the form.</div>
        }
        else
        {
            <div class="rd-table table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Category</th><th>Distance</th><th>Entry fee (R)</th><th>Max</th><th>Enrolled</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.EventCategories)
                        {
                            <tr>
                                <td><strong>@c.CategoryName</strong><div class="small text-muted">@c.ActivityType</div></td>
                                <td>@Format.Distance(c.DistanceKm)</td>
                                <td colspan="2">
                                    <form asp-action="UpdateEventCategory" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                        <input type="hidden" name="eventCategoryId" value="@c.EventCategoryId" />
                                        <input type="number" name="entryFee" value="@c.EntryFee.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" step="0.01" min="0" class="form-control form-control-sm" style="width:110px" aria-label="Entry fee" required />
                                        <input type="number" name="maximumParticipants" value="@c.MaximumParticipants" min="1" class="form-control form-control-sm" style="width:90px" aria-label="Maximum participants" required />
                                        <button type="submit" class="btn btn-sm btn-rd-outline" title="Save"><i class="bi bi-check2"></i></button>
                                    </form>
                                </td>
                                <td>@c.EnrolledCount</td>
                                <td class="text-end">
                                    <form asp-action="RemoveEventCategory" method="post" data-confirm="Remove '@c.CategoryName' from this event?">
                                        <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                        <input type="hidden" name="eventCategoryId" value="@c.EventCategoryId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="rd-panel mb-4">
            <h2>Add a category</h2>
            @if (Model.AvailableCategories.Count == 0)
            {
                <p class="text-muted mb-0">Every available category is already on this event. Create a new one below.</p>
            }
            else
            {
                <form asp-action="AttachCategory" method="post">
                    <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                    <div class="mb-3">
                        <label for="CategoryId" class="form-label">Category</label>
                        <select id="CategoryId" name="CategoryId" class="form-select" required>
                            <option value="">Choose...</option>
                            @foreach (var c in Model.AvailableCategories)
                            {
                                <option value="@c.CategoryId">@c.CategoryName (@Format.Distance(c.DistanceKm), @c.ActivityType)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="EntryFee" class="form-label">Entry fee (R)</label>
                            <input id="EntryFee" name="EntryFee" type="number" step="0.01" min="0" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label for="MaximumParticipants" class="form-label">Max entries</label>
                            <input id="MaximumParticipants" name="MaximumParticipants" type="number" min="1" class="form-control" required />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-rd w-100">Add to event</button>
                </form>
            }
        </div>

        <div class="rd-panel">
            <h2>New category type</h2>
            <p class="small text-muted">Need something that isn't listed, e.g. an age group like "Under 20"? Create it here, then add it to the event.</p>
            <form asp-action="CreateCategory" method="post">
                <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                <div class="mb-2">
                    <label for="CategoryName" class="form-label">Name</label>
                    <input id="CategoryName" name="CategoryName" class="form-control" maxlength="100" required />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label for="DistanceKm" class="form-label">Distance (km)</label>
                        <input id="DistanceKm" name="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label for="ActivityType" class="form-label">Activity</label>
                        <select id="ActivityType" name="ActivityType" class="form-select">
                            <option>Run</option><option>Walk</option><option>Cycle</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="Description" class="form-label">Description</label>
                    <input id="Description" name="Description" class="form-control" maxlength="500" />
                </div>
                <button type="submit" class="btn btn-rd-outline w-100">Create category</button>
            </form>
        </div>
    </div>
</div>
