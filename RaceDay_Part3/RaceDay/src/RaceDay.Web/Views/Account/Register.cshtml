@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }

<div class="auth-wrap">
    <div class="rd-panel">
        <h1 class="mb-1">Join RaceDay</h1>
        <p class="text-muted">Create your account in under a minute.</p>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label class="form-label d-block">I am a...</label>
                <div class="btn-group w-100" role="group" aria-label="Account type">
                    <input type="radio" class="btn-check" asp-for="Role" value="Participant" id="role-participant" />
                    <label class="btn btn-rd-outline" for="role-participant"><i class="bi bi-person-running"></i> Participant</label>
                    <input type="radio" class="btn-check" asp-for="Role" value="Organiser" id="role-organiser" />
                    <label class="btn btn-rd-outline" for="role-organiser"><i class="bi bi-clipboard-check"></i> Organiser</label>
                </div>
                <span asp-validation-for="Role"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">At least 8 characters.</div>
                <span asp-validation-for="Password"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
            <button type="submit" class="btn btn-rd w-100" data-busy="Creating account...">Create account</button>
        </form>
        <p class="text-center mt-3 mb-0">Already registered? <a asp-action="Login">Log in</a></p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScripts" /> }
