@model HomeViewModel
@{
    ViewData["Title"] = "Upcoming events";
    var me = Context.Session.GetCurrentUser();
    var filtering = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Province)
                    || !string.IsNullOrWhiteSpace(Model.EventType) || Model.From.HasValue;
}

<section class="hero">
    <h1>Find your next race</h1>
    <p>Browse upcoming runs, walks and cycles across South Africa, pick your category and get on the start line.</p>
    @if (!me.IsAuthenticated)
    {
        <div class="mt-3 d-flex gap-2 flex-wrap">
            <a class="btn btn-rd" asp-controller="Account" asp-action="Register">Create a free account</a>
            <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login">Log in</a>
        </div>
    }
</section>

<form method="get" asp-action="Index" class="filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-lg-4 col-md-6">
            <label for="search" class="form-label mb-1">Search</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event name, city or venue" />
        </div>
        <div class="col-lg-2 col-md-6">
            <label for="province" class="form-label mb-1">Province</label>
            <select id="province" name="province" class="form-select">
                <option value="">All provinces</option>
                @foreach (var p in Model.Provinces)
                {
                    <option value="@p" selected="@(string.Equals(p, Model.Province, StringComparison.OrdinalIgnoreCase))">@p</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-4">
            <label for="type" class="form-label mb-1">Type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                @foreach (var t in EventFormViewModel.EventTypes)
                {
                    <option value="@t" selected="@(string.Equals(t, Model.EventType, StringComparison.OrdinalIgnoreCase))">@t</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-4">
            <label for="from" class="form-label mb-1">On or after</label>
            <input id="from" type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-lg-2 col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-rd flex-grow-1"><i class="bi bi-funnel"></i> Filter</button>
            @if (filtering)
            {
                <a class="btn btn-outline-secondary" asp-action="Index" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="rd-panel text-center py-5">
        <div class="display-4 text-muted"><i class="bi bi-calendar-x"></i></div>
        <h2 class="mt-2">@(filtering ? "No events match your filters" : "No upcoming events yet")</h2>
        <p class="text-muted mb-0">@(filtering ? "Try widening your search or clearing the filters." : "Check back soon - new races are added all the time.")</p>
    </div>
}
else
{
    <p class="text-muted">Showing <strong>@Model.Events.Count</strong> of @Model.TotalUpcoming upcoming events.</p>
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-xl-4">
                <partial name="_EventCard" model="ev" />
            </div>
        }
    </div>
}
