@model List<MyEventRow>
@{ ViewData["Title"] = "My enrolments"; }

<div class="page-head">
    <div>
        <h1>My enrolments</h1>
        <p>Every event you've enrolled for, with your category, race number and status.</p>
    </div>
    <a class="btn btn-rd" asp-controller="Home" asp-action="Index"><i class="bi bi-search"></i> Find more events</a>
</div>

<p class="legend small text-muted">
    <span class="status-badge status-amber">Registered</span> awaiting confirmation
    <span class="status-badge status-green">Confirmed</span> ready to race
    <span class="status-badge status-red">Cancelled</span>
</p>

@if (Model.Count == 0)
{
    <div class="rd-panel text-center py-5">
        <div class="display-4 text-muted"><i class="bi bi-ticket-perforated"></i></div>
        <h2 class="mt-2">You haven't enrolled for anything yet</h2>
        <p class="text-muted">Browse upcoming events and pick your first race.</p>
        <a class="btn btn-rd" asp-controller="Home" asp-action="Index">Browse events</a>
    </div>
}
else
{
    <div class="rd-table table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Race no.</th><th>Enrolment status</th><th>Registration</th><th></th></tr></thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var finished = row.Enrollment.Status is "Completed" or "DNF" or "DNS" or "Disqualified";
                    <tr>
                        <td>
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@row.Enrollment.EventId"><strong>@row.Enrollment.EventName</strong></a>
                            @if (row.Event is not null) { <div class="small text-muted">@row.Event.City, @row.Event.Province</div> }
                        </td>
                        <td>@(row.Event is null ? "-" : row.Event.EventDate.ToString("d MMM yyyy"))</td>
                        <td>@row.Enrollment.CategoryName</td>
                        <td>@(string.IsNullOrWhiteSpace(row.Registration?.RaceNumber) ? "-" : row.Registration!.RaceNumber)</td>
                        <td><span class="status-badge @Format.StatusClass(row.Enrollment.Status)">@row.Enrollment.Status</span></td>
                        <td>
                            @if (row.Registration is not null)
                            {
                                <span class="status-badge @Format.StatusClass(row.Registration.Status)">@row.Registration.Status</span>
                            }
                            else { <span class="text-muted">-</span> }
                        </td>
                        <td class="text-end">
                            @if (!finished)
                            {
                                <form asp-action="CancelEnrolment" asp-route-id="@row.Enrollment.EnrollmentId" method="post" data-confirm="Cancel your enrolment for @row.Enrollment.EventName?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
