@model EventDto
<div class="card rd-card event-card h-100">
    <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.EventId" class="event-banner" aria-label="View @Model.EventName">
        @if (!string.IsNullOrEmpty(Model.BannerUrl))
        {
            <img src="@Model.BannerUrl" alt="@Model.EventName banner" loading="lazy" />
        }
        else
        {
            <div class="event-banner-fallback"><i class="bi bi-@(Model.EventType == "Cycle" ? "bicycle" : "lightning-charge-fill")"></i></div>
        }
        <span class="event-type-chip">@Model.EventType</span>
    </a>
    <div class="card-body d-flex flex-column">
        <div class="event-date"><i class="bi bi-calendar-event"></i> @Model.EventDate.ToString("ddd, d MMM yyyy") &middot; @Format.ClockTime(Model.StartTime)</div>
        <h3 class="event-title">@Model.EventName</h3>
        <p class="text-muted small mb-2"><i class="bi bi-geo-alt-fill"></i> @Model.City, @Model.Province</p>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="small flex-grow-1 line-clamp">@Model.Description</p>
        }
        else
        {
            <div class="flex-grow-1"></div>
        }
        <div class="d-flex justify-content-between align-items-center mt-2">
            @if (Model.DistanceKm.HasValue)
            {
                <span class="fw-semibold"><i class="bi bi-signpost-split"></i> @Format.Distance(Model.DistanceKm.Value)</span>
            }
            else
            {
                <span></span>
            }
            <a class="btn btn-rd btn-sm" asp-controller="Home" asp-action="Details" asp-route-id="@Model.EventId">View event</a>
        </div>
    </div>
</div>
